# =============================================================================
# PatchWeave Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
PATCHWEAVE_ENV=development          # development | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FILE=logs/patchweave.log

# -----------------------------------------------------------------------------
# Jira Configuration
# -----------------------------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=              # Project key to monitor for findings
JIRA_OPEN_STATUS=Open                # Status name for new findings (must match exactly!)
JIRA_POLL_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------0+--------
# AWS Test Environment
# Used for validation workflow (LocalStack or dedicated test account)
# -----------------------------------------------------------------------------
AWS_TEST_ACCESS_KEY_ID=test          # Use 'test' for LocalStack
AWS_TEST_SECRET_ACCESS_KEY=test      # Use 'test' for LocalStack
AWS_TEST_REGION=us-east-1

# -----------------------------------------------------------------------------
# AWS Production Environment
# Used by Deployment Agent for actual remediation
# IMPORTANT: Keep these credentials secure!
# -----------------------------------------------------------------------------
AWS_PROD_ACCESS_KEY_ID=
AWS_PROD_SECRET_ACCESS_KEY=
AWS_PROD_REGION=us-east-1

# -----------------------------------------------------------------------------
# LocalStack Configuration (Dual Environment)
# TEST: Used for validation (port 4566)
# PROD: Used for actual remediation (port 4567)
# -----------------------------------------------------------------------------
LOCALSTACK_TEST_ENDPOINT=http://localhost:4566
LOCALSTACK_PROD_ENDPOINT=http://localhost:4567
USE_LOCALSTACK=true                  # Set to false for real AWS

# -----------------------------------------------------------------------------
# Deployment Configuration  
# -----------------------------------------------------------------------------
DEPLOYMENT_DRY_RUN=false             # Set to true to simulate without changes

# -----------------------------------------------------------------------------
# ChromaDB Configuration
# -----------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./chroma_data

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# LLM Provider: 'gemini' (recommended for free tier) or 'openai'
LLM_PROVIDER=gemini

# Enable/Disable LLM for analysis (set to false to use direct ChromaDB matching)
# When false, skips Gemini analysis and matches playbooks directly by similarity
USE_LLM=false

# Google Gemini API (Free Tier) - Get key at https://aistudio.google.com/apikey
# Multiple keys supported for rate limit rotation
GOOGLE_API_KEY=
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=

# OpenAI API (Optional) - Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=                      # Required when LLM_PROVIDER=openai

# Model to use (gemini-1.5-flash for free tier, gpt-4-turbo-preview for OpenAI)
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# Playbooks
# -----------------------------------------------------------------------------
PLAYBOOKS_DIRECTORY=./playbooks

# -----------------------------------------------------------------------------
# Matching Thresholds
# -----------------------------------------------------------------------------
HIGH_CONFIDENCE_THRESHOLD=0.90
MODERATE_CONFIDENCE_THRESHOLD=0.70

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8080
